# ==============================================================================
# AddaRoom — Environment Configuration
# Free-First & Open-Source Private Hangout Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY PRODUCTION DEPLOYMENT (REMOTE FREE MANAGED CLOUD)
# ------------------------------------------------------------------------------
# Your personal PC is NEVER used as a production server.
# Production runs 100% remotely across zero-cost free-tier services:
# - Next.js & API: Hosted on Vercel Hobby (auto-deploy from GitHub)
# - PostgreSQL: Hosted on Supabase Free (metadata, sessions, capacity locks)
# - Media SFU: Hosted on LiveKit Cloud Build (audio/video/screen/data packets)

NODE_ENV=production

# Supabase Free PostgreSQL URI (use the Transaction Pooler URI on port 6543)
# Found in: Supabase Project Settings -> Database -> Connection String -> URI (Session/Transaction pooler)
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# LiveKit Cloud Build Credentials
# Found in: https://cloud.livekit.io -> Project Settings -> Keys
LIVEKIT_URL=https://[YOUR_PROJECT_ID].livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://[YOUR_PROJECT_ID].livekit.cloud
LIVEKIT_API_KEY=[YOUR_LIVEKIT_API_KEY]
LIVEKIT_API_SECRET=[YOUR_LIVEKIT_API_SECRET]

# Cryptographic salt for privacy-preserving rate limiting
RATE_LIMIT_SECRET=[GENERATE_RANDOM_32_CHAR_SECRET]

# ------------------------------------------------------------------------------
# 2. LOCAL DEVELOPMENT ON PERSONAL PC (CODING, TESTING, GIT ONLY)
# ------------------------------------------------------------------------------
# In local development (`pnpm dev`), AddaRoom uses an automatic in-memory fallback
# if DATABASE_URL is unset, or you can point to a remote Supabase dev database or
# a temporary local container.
#
# LIVEKIT_URL=http://localhost:7880
# NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# ------------------------------------------------------------------------------
# 3. FUTURE MIGRATION: REMOTE SELF-HOSTED CLOUD VM (ORACLE ALWAYS FREE / VPS)
# ------------------------------------------------------------------------------
# For future migration away from managed free tiers to a remote Cloud VM:
# (e.g. Oracle Cloud Always Free 4 OCPU / 24GB ARM instance or remote Linux VPS)
#
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/addaroom
# LIVEKIT_URL=http://livekit:7880
# NEXT_PUBLIC_LIVEKIT_URL=wss://adda.yourdomain.com/livekit
# LIVEKIT_API_KEY=[VM_STRONG_KEY]
# LIVEKIT_API_SECRET=[VM_STRONG_SECRET]
# DOMAIN_NAME=adda.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com
