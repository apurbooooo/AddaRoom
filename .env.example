# ==============================================================================
# AddaRoom — Environment Configuration
# Free-First & Open-Source Private Hangout Platform
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# MODE A: LOCAL / SELF-HOSTED OPEN-SOURCE MODE (DEFAULT)
# ------------------------------------------------------------------------------
# PostgreSQL Database URL
# In Docker Compose: postgres://postgres:postgres@postgres:5432/addaroom
# In local host dev: postgres://postgres:postgres@localhost:5432/addaroom
# (If omitted during rapid local testing, an in-memory store is automatically used)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/addaroom

# LiveKit Open Source Server Configuration
# Server-to-server HTTP API URL (used by Next.js API routes to mint tokens & moderate)
LIVEKIT_URL=http://localhost:7880

# Browser WebSocket Media URL (accessed by client browsers)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# LiveKit API Credentials (must match livekit.yaml or LIVEKIT_KEYS)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional Caddy Production HTTPS Domain
DOMAIN_NAME=adda.example.com
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# MODE B: FREE CLOUD BETA MODE (OPTIONAL)
# ------------------------------------------------------------------------------
# 1. Next.js hosted on Vercel Hobby
# 2. Database on Supabase Free / Neon PostgreSQL (Session Pooling connection string)
#    DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# 3. LiveKit Cloud Free Tier or self-hosted media node:
#    LIVEKIT_URL=https://[project-id].livekit.cloud
#    NEXT_PUBLIC_LIVEKIT_URL=wss://[project-id].livekit.cloud
#    LIVEKIT_API_KEY=[cloud-api-key]
#    LIVEKIT_API_SECRET=[cloud-api-secret]
